---
import Layout from './Layout.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  updated: string;
}

const { title, description, updated } = Astro.props;
---

<Layout title={`${title} | HBA - Hamza Bashir Marketing Agency`} description={description}>
  <header class="w-full border-b border-stone-200/80 dark:border-stone-800/80">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 h-20 flex items-center justify-between">
      <a href="/" class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-amber-500 flex items-center justify-center font-extrabold text-stone-950 text-xl tracking-tighter">
          HBA
        </div>
        <span class="font-extrabold text-lg tracking-tight">HBA Agency</span>
      </a>
      <a href="/" class="text-sm font-semibold text-stone-600 dark:text-stone-300 hover:text-amber-600 dark:hover:text-amber-400 transition-colors">
        &larr; Back to home
      </a>
    </div>
  </header>

  <main class="max-w-3xl mx-auto px-4 sm:px-6 py-14">
    <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight mb-2">{title}</h1>
    <p class="text-sm text-stone-500 dark:text-stone-400 mb-10">Last updated: {updated}</p>
    <article class="legal space-y-5 text-[15px] leading-relaxed text-stone-700 dark:text-stone-300">
      <slot />
    </article>
  </main>

  <Footer />
</Layout>

<style is:global>
  .legal h2 { font-size: 1.25rem; font-weight: 700; margin-top: 2.25rem; color: inherit; }
  .legal ul { list-style: disc; padding-left: 1.25rem; }
  .legal li { margin-top: 0.4rem; }
  .legal a { color: #d97706; text-decoration: underline; }
  .dark .legal a { color: #fbbf24; }
  .legal h2 { color: #1c1917; }
  .dark .legal h2 { color: #f5f5f4; }
</style>
