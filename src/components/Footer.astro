---
const currentYear = new Date().getFullYear();
---

<footer class="bg-stone-950 text-stone-400 py-16 border-t border-stone-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 mb-12">
      <!-- Brand & Mission -->
      <div class="md:col-span-5 space-y-4">
        <a href="#" class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-lg bg-amber-500 flex items-center justify-center font-extrabold text-stone-950 text-lg tracking-tighter">
            HBA
          </div>
          <span class="font-extrabold text-xl text-white tracking-tight">
            HBA Agency
          </span>
        </a>

        <p class="text-sm text-stone-400 max-w-md leading-relaxed">
          Hamza Bashir Marketing Agency — Your Trusted E-Commerce Growth Partner. Over <strong>₹10Cr+</strong> in Attributed Revenue generated for e-commerce brands on Meta, TikTok, Snapchat, Google, and YouTube.
        </p>
      </div>

      <!-- Quick Links -->
      <div class="md:col-span-3 space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-white">Quick Navigation</h4>
        <ul class="space-y-2 text-sm font-medium">
          <li><a href="#services" class="hover:text-amber-400 transition-colors">Services</a></li>
          <li><a href="#case-studies" class="hover:text-amber-400 transition-colors">Case Studies</a></li>
          <li><a href="#why-us" class="hover:text-amber-400 transition-colors">Why HBA</a></li>
          <li><a href="#process" class="hover:text-amber-400 transition-colors">Our 3-Step Process</a></li>
          <li><a href="#testimonials" class="hover:text-amber-400 transition-colors">Client Testimonials</a></li>
        </ul>
      </div>

      <!-- Contact & Direct Inquiry -->
      <div class="md:col-span-4 space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-white">Direct Contact Info</h4>
        
        <div class="space-y-3 text-sm">
          <!-- WhatsApp Phone -->
          <a
            href="https://wa.me/923477765284"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2.5 p-3 rounded-xl bg-stone-900 border border-stone-800 hover:border-emerald-500/50 text-stone-200 hover:text-emerald-400 transition-colors group"
          >
            <div class="w-8 h-8 rounded-lg bg-emerald-500/10 text-emerald-400 flex items-center justify-center shrink-0">
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
              </svg>
            </div>
            <div>
              <div class="text-[10px] uppercase font-bold text-stone-500">Phone & WhatsApp</div>
              <div class="font-bold text-sm">+92 347 7765284</div>
            </div>
          </a>

          <!-- Email Address -->
          <a
            href="mailto:hamza@hba.agency"
            class="flex items-center gap-2.5 p-3 rounded-xl bg-stone-900 border border-stone-800 hover:border-amber-500/50 text-stone-200 hover:text-amber-400 transition-colors group"
          >
            <div class="w-8 h-8 rounded-lg bg-amber-500/10 text-amber-400 flex items-center justify-center shrink-0">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <div class="text-[10px] uppercase font-bold text-stone-500">Email Address</div>
              <div class="font-bold text-sm">hamza@hba.agency</div>
            </div>
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 border-t border-stone-900 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-medium text-stone-500">
      <div>
        © {currentYear} HBA (Hamza Bashir Marketing Agency). All rights reserved.
      </div>

      <div class="flex items-center gap-6">
        <a href="#book-call" class="open-booking-modal hover:text-stone-300 transition-colors">Book Call</a>
        <a href="#services" class="hover:text-stone-300 transition-colors">Services</a>
        <a href="#case-studies" class="hover:text-stone-300 transition-colors">Results</a>
      </div>
    </div>
  </div>
</footer>
