---
---

<section class="relative pt-12 pb-20 md:pt-20 md:pb-28 overflow-hidden">
  <!-- Subtle Background Glows -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[300px] bg-amber-500/10 dark:bg-amber-500/5 blur-[120px] rounded-full pointer-events-none"></div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
    <!-- Trust Pill Badge -->
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-amber-500/10 dark:bg-amber-400/10 border border-amber-500/20 text-amber-700 dark:text-amber-400 text-xs sm:text-sm font-bold mb-8">
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-amber-500"></span>
      </span>
      Trusted Partner for 40+ E-Commerce Brands
    </div>

    <!-- Main Headline -->
    <h1 class="text-3xl sm:text-5xl md:text-6xl font-extrabold text-stone-900 dark:text-stone-100 tracking-tight leading-[1.15] max-w-4xl mx-auto mb-6">
      Scale Your E-Commerce Brand to <span class="text-amber-600 dark:text-amber-400 underline decoration-amber-500/40 underline-offset-8">5,000+ Orders</span> Per Month
    </h1>

    <!-- Subheadline -->
    <p class="text-lg sm:text-xl text-stone-600 dark:text-stone-300 max-w-3xl mx-auto font-normal leading-relaxed mb-10">
      With Proven Ads, Psychology-Driven Creatives, and High-Converting Influencer Strategies. We help ambitious e-commerce founders scale revenue effortlessly across Meta, TikTok, Google, Snapchat & YouTube.
    </p>

    <!-- Call To Action Group -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-14">
      <a
        href="#book-call"
        class="open-booking-modal w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 rounded-xl text-base sm:text-lg font-bold bg-amber-500 hover:bg-amber-400 text-stone-950 shadow-lg shadow-amber-500/25 hover:shadow-amber-500/40 hover:scale-[1.02] active:scale-[0.98] transition-all group"
      >
        <span>Book Your Free Growth Strategy Call</span>
        <svg class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>

      <a
        href="#case-studies"
        class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-4 rounded-xl text-base sm:text-lg font-semibold bg-stone-200/70 dark:bg-stone-900 hover:bg-stone-300 dark:hover:bg-stone-800 text-stone-800 dark:text-stone-200 border border-stone-300 dark:border-stone-800 transition-colors"
      >
        View Proven Results
      </a>
    </div>

    <!-- Guarantee Subtext -->
    <p class="text-xs sm:text-sm font-medium text-stone-500 dark:text-stone-400 flex items-center justify-center gap-2">
      <svg class="w-4 h-4 text-emerald-500" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
      </svg>
      By the end of this call, you’ll get a clear roadmap to 3X your sales in 90 days — 100% Free.
    </p>

    <!-- Key Metrics Ribbon -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-14 pt-10 border-t border-stone-200 dark:border-stone-800/80">
      <div class="p-4 rounded-xl bg-stone-100/60 dark:bg-stone-900/40 border border-stone-200/60 dark:border-stone-800/50">
        <div class="text-2xl sm:text-3xl font-extrabold text-stone-900 dark:text-stone-100">₹10Cr+</div>
        <div class="text-xs font-semibold uppercase tracking-wider text-stone-500 dark:text-stone-400 mt-1">Attributed Revenue</div>
      </div>
      <div class="p-4 rounded-xl bg-stone-100/60 dark:bg-stone-900/40 border border-stone-200/60 dark:border-stone-800/50">
        <div class="text-2xl sm:text-3xl font-extrabold text-stone-900 dark:text-stone-100">40+</div>
        <div class="text-xs font-semibold uppercase tracking-wider text-stone-500 dark:text-stone-400 mt-1">Brands Scaled</div>
      </div>
      <div class="p-4 rounded-xl bg-stone-100/60 dark:bg-stone-900/40 border border-stone-200/60 dark:border-stone-800/50">
        <div class="text-2xl sm:text-3xl font-extrabold text-amber-600 dark:text-amber-400">Up to 5.1X</div>
        <div class="text-xs font-semibold uppercase tracking-wider text-stone-500 dark:text-stone-400 mt-1">Campaign ROAS</div>
      </div>
      <div class="p-4 rounded-xl bg-stone-100/60 dark:bg-stone-900/40 border border-stone-200/60 dark:border-stone-800/50">
        <div class="text-2xl sm:text-3xl font-extrabold text-stone-900 dark:text-stone-100">5,000+</div>
        <div class="text-xs font-semibold uppercase tracking-wider text-stone-500 dark:text-stone-400 mt-1">Orders / Month Goal</div>
      </div>
    </div>
  </div>
</section>
