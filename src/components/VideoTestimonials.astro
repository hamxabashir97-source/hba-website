---
interface VideoReview {
  id: string;
  embedUrl: string;
}

const videoReviews: VideoReview[] = [
  {
    id: "review-1",
    embedUrl: "https://drive.google.com/file/d/1GHHSFYkd9sRl3ckJemLvzVALYZ_x57iS/preview"
  },
  {
    id: "review-2",
    embedUrl: "https://drive.google.com/file/d/1aj0eNNcqPrqH_HR_99lJ_laPU62-4WaC/preview"
  },
  {
    id: "review-3",
    embedUrl: "https://drive.google.com/file/d/1Xen4rmEb5NSjOCkbn60ThspzGa3-Kyv_/preview"
  },
  {
    id: "review-4",
    embedUrl: "https://drive.google.com/file/d/1RUorbODuVmgpv3vsC8FEcPRMtiAvabju/preview"
  },
  {
    id: "review-5",
    embedUrl: "https://drive.google.com/file/d/1ybg06EpkR07PC9KtZ6NS4yq-2SnP93OO/preview"
  },
  {
    id: "review-6",
    embedUrl: "https://drive.google.com/file/d/1S-ETJ3HFpjPwAvay9PhYq7QO1yElC7dk/preview"
  }
];
---

<section id="video-reviews" class="py-20 md:py-28 bg-stone-100/70 dark:bg-stone-900/40 border-t border-stone-200/80 dark:border-stone-800/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-14">
      <span class="text-xs font-bold uppercase tracking-widest text-amber-600 dark:text-amber-400">
        Video Case Studies & Client Reviews
      </span>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-stone-900 dark:text-stone-100 mt-2 tracking-tight">
        Watch Founders Share Their HBA Success Stories
      </h2>
      <p class="text-stone-600 dark:text-stone-400 mt-4 text-base sm:text-lg">
        Real brand owners sharing their exact experience scaling with Hamza Bashir Marketing Agency.
      </p>
    </div>

    <!-- Clean Video Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
      {videoReviews.map((item) => (
        <div class="rounded-2xl bg-stone-950 border border-stone-200/80 dark:border-stone-800 overflow-hidden shadow-md hover:shadow-2xl hover:border-amber-500/50 transition-all relative group">
          
          <!-- Video Frame Container -->
          <div class="relative w-full aspect-[9/16] bg-stone-950 flex items-center justify-center overflow-hidden">
            <!-- Google Drive iFrame Player -->
            <iframe
              src={item.embedUrl}
              title="Client Video Testimonial"
              allow="autoplay; encrypted-media"
              allowfullscreen
              class="w-full h-full border-0 pointer-events-auto"
              loading="lazy"
            ></iframe>

            <!-- Blocking Overlay on Top Right Popout Icon to Keep Visitors on Site -->
            <div 
              class="absolute top-0 right-0 w-16 h-14 z-30 bg-transparent cursor-default pointer-events-auto"
              title="Watch video on site"
            ></div>
          </div>
        </div>
      ))}
    </div>

    <!-- Bottom CTA Trigger -->
    <div class="mt-14 text-center">
      <a
        href="#book-call"
        class="open-booking-modal inline-flex items-center justify-center px-8 py-4 rounded-xl text-base font-bold bg-amber-500 hover:bg-amber-400 text-stone-950 shadow-lg shadow-amber-500/20 hover:scale-105 transition-all"
      >
        Book Your Strategy Call to Get Same Results
      </a>
    </div>
  </div>
</section>
