---
const reviews = [
  {
    author: "Skincare Brand Founder",
    brandType: "D2C Skincare & Beauty",
    quote: "Working with HBA was a game-changer—they scaled our sales 3X in just 2 months with their TikTok ads and influencer videos!",
    metric: "3X Sales Growth in 2 Months",
    platform: "TikTok & UGC Ads"
  },
  {
    author: "Fashion Brand Owner",
    brandType: "Women's Apparel & Fashion",
    quote: "Their creative strategies and ad management are unmatched—we hit ₹1Cr in monthly revenue for the first time ever!",
    metric: "Hit ₹1Cr / Month Revenue",
    platform: "Meta & YouTube Ads"
  },
  {
    author: "Wellness Brand Founder",
    brandType: "Health & Wellness D2C",
    quote: "The influencer videos they produced for our ads were incredible—our ROAS shot up to 5X!",
    metric: "ROAS Shot Up To 5X",
    platform: "Influencer Ads"
  }
];
---

<section id="testimonials" class="py-20 md:py-28 bg-stone-50 dark:bg-stone-950">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-xs font-bold uppercase tracking-widest text-amber-600 dark:text-amber-400">
        Founder Reviews
      </span>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-stone-900 dark:text-stone-100 mt-2 tracking-tight">
        Hear Why E-Commerce Brands Trust Us to Scale Their Sales!
      </h2>
      <p class="text-stone-600 dark:text-stone-400 mt-4 text-base sm:text-lg">
        Direct words from brand founders who partnered with HBA to unlock profitable scale.
      </p>
    </div>

    <!-- Testimonials Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-14">
      {reviews.map((rev) => (
        <div class="p-8 rounded-2xl bg-white dark:bg-stone-900 border border-stone-200 dark:border-stone-800 shadow-sm flex flex-col justify-between hover:border-amber-500/50 transition-all group">
          <div>
            <!-- Star Rating -->
            <div class="flex items-center gap-1 text-amber-500 mb-6">
              {[...Array(5)].map(() => (
                <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
              ))}
            </div>

            <!-- Quote Text -->
            <p class="text-base sm:text-lg font-medium text-stone-800 dark:text-stone-200 leading-relaxed mb-6 italic">
              "{rev.quote}"
            </p>
          </div>

          <div>
            <!-- Metric Badge -->
            <div class="inline-block px-3 py-1 rounded-md text-xs font-bold bg-amber-500/10 text-amber-700 dark:text-amber-400 border border-amber-500/20 mb-4">
              {rev.metric}
            </div>

            <div class="pt-4 border-t border-stone-100 dark:border-stone-800 flex items-center justify-between">
              <div>
                <h4 class="font-bold text-stone-900 dark:text-stone-100 text-sm">
                  {rev.author}
                </h4>
                <p class="text-xs text-stone-500 dark:text-stone-400">
                  {rev.brandType}
                </p>
              </div>
              <span class="text-[10px] font-semibold text-stone-400 dark:text-stone-500 uppercase">
                {rev.platform}
              </span>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Bottom Action Text -->
    <div class="text-center">
      <p class="text-stone-600 dark:text-stone-400 text-sm sm:text-base font-semibold mb-4">
        These brands trusted us to scale their businesses—and we delivered. Let us do the same for you!
      </p>
      <a
        href="#book-call"
        class="open-booking-modal inline-flex items-center justify-center px-6 py-3.5 rounded-xl text-sm font-bold bg-amber-500 hover:bg-amber-400 text-stone-950 shadow-md hover:scale-105 transition-all"
      >
        Join These Happy Clients — Book Your Free Call Today!
      </a>
    </div>
  </div>
</section>
