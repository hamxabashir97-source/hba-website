---
---

<div id="booking-modal-backdrop" class="fixed inset-0 z-50 hidden bg-stone-950/85 backdrop-blur-md flex items-center justify-center p-3 sm:p-4 overflow-y-auto">
  <div class="relative w-full max-w-xl bg-white dark:bg-stone-900 border border-stone-200 dark:border-stone-800 rounded-2xl shadow-2xl p-6 sm:p-8 my-6 text-stone-900 dark:text-stone-100 transition-all">
    <!-- Close Button -->
    <button
      id="close-booking-modal"
      type="button"
      class="absolute top-4 right-4 p-2 text-stone-400 hover:text-stone-700 dark:hover:text-stone-200 transition-colors rounded-lg bg-stone-100 dark:bg-stone-800"
      aria-label="Close modal"
    >
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <!-- Header & Progress -->
    <div class="mb-6">
      <div class="flex items-center justify-between mb-2">
        <span class="px-2.5 py-1 rounded-md text-[11px] font-bold bg-amber-500/10 text-amber-700 dark:text-amber-400 border border-amber-500/20 uppercase tracking-wider">
          Growth Audit & Strategy Call
        </span>
        <span id="step-indicator" class="text-xs font-bold text-stone-500 dark:text-stone-400">
          Step 1 of 4
        </span>
      </div>

      <!-- Step Progress Bar -->
      <div class="w-full bg-stone-100 dark:bg-stone-800 h-1.5 rounded-full overflow-hidden">
        <div id="progress-bar" class="bg-amber-500 h-full w-1/4 transition-all duration-300"></div>
      </div>
    </div>

    <!-- Main Questionnaire Form -->
    <form id="whatsapp-audit-form">

      <!-- STEP 1: Website & Revenue -->
      <div id="form-step-1" class="step-pane space-y-5">
        <div>
          <h3 class="text-xl font-extrabold text-stone-900 dark:text-stone-100">Let's start with your store details</h3>
          <p class="text-xs sm:text-sm text-stone-500 dark:text-stone-400 mt-1">Provide your store URL and current scale so we can review your brand ahead of the call.</p>
        </div>

        <div>
          <label for="input-website-url" class="block text-xs font-bold uppercase tracking-wider text-stone-700 dark:text-stone-300 mb-1.5">
            Website / Store URL *
          </label>
          <input
            type="text"
            id="input-website-url"
            name="websiteUrl"
            required
            placeholder="e.g. https://yourbrand.com"
            class="w-full px-4 py-3 rounded-xl border border-stone-300 dark:border-stone-700 bg-stone-50 dark:bg-stone-800 text-stone-900 dark:text-stone-100 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500"
          />
        </div>

        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-stone-700 dark:text-stone-300 mb-2">
            What is your average monthly ecommerce revenue? *
          </label>
          <div class="space-y-2.5">
            {[
              "Under 20 Lakh",
              "20–50 Lakh",
              "50 Lakh–1 Crore",
              "1–2.5 Crore",
              "2.5–5 Crore"
            ].map((rev, idx) => (
              <label class="radio-card flex items-center justify-between p-3.5 sm:p-4 rounded-xl border border-stone-200 dark:border-stone-700/80 bg-stone-50/50 dark:bg-stone-800/40 hover:bg-stone-100 dark:hover:bg-stone-800 cursor-pointer transition-all">
                <span class="text-sm font-semibold text-stone-800 dark:text-stone-200">{rev}</span>
                <input type="radio" name="monthlyRevenue" value={rev} required={idx === 0} class="w-4 h-4 text-amber-500 focus:ring-amber-500 border-stone-300 dark:border-stone-600" />
              </label>
            ))}
          </div>
        </div>

        <button
          type="button"
          id="btn-next-1"
          class="w-full py-3.5 px-4 rounded-xl text-sm font-bold bg-amber-500 hover:bg-amber-400 text-stone-950 shadow-md transition-all flex items-center justify-center gap-2"
        >
          <span>Continue</span>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </button>
      </div>

      <!-- STEP 2: Paid Ad Spend & Biggest Challenge -->
      <div id="form-step-2" class="step-pane hidden space-y-5">
        <div>
          <h3 class="text-xl font-extrabold text-stone-900 dark:text-stone-100">Ad Spend & Growth Bottlenecks</h3>
          <p class="text-xs sm:text-sm text-stone-500 dark:text-stone-400 mt-1">Help us understand where your advertising budget is currently going.</p>
        </div>

        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-stone-700 dark:text-stone-300 mb-2">
            How much are you currently spending on paid advertising per month? *
          </label>
          <div class="space-y-2">
            {[
              "Under 1 Lakh",
              "Under 5 Lakh",
              "5–10 Lakh",
              "10–25 Lakh",
              "25 Lakh+"
            ].map((spend) => (
              <label class="radio-card flex items-center justify-between p-3 rounded-xl border border-stone-200 dark:border-stone-700/80 bg-stone-50/50 dark:bg-stone-800/40 hover:bg-stone-100 dark:hover:bg-stone-800 cursor-pointer transition-all">
                <span class="text-sm font-semibold text-stone-800 dark:text-stone-200">{spend}</span>
                <input type="radio" name="adSpend" value={spend} class="w-4 h-4 text-amber-500 focus:ring-amber-500" />
              </label>
            ))}
          </div>
        </div>

        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-stone-700 dark:text-stone-300 mb-2">
            What is your biggest challenge right now? *
          </label>
          <div class="space-y-2">
            {[
              "Ad costs are too high",
              "Sales aren't growing despite increasing ad spend",
              "ROAS/profitability is too low",
              "Ads have become inconsistent",
              "My current agency isn't delivering results"
            ].map((challenge) => (
              <label class="radio-card flex items-center justify-between p-3 rounded-xl border border-stone-200 dark:border-stone-700/80 bg-stone-50/50 dark:bg-stone-800/40 hover:bg-stone-100 dark:hover:bg-stone-800 cursor-pointer transition-all">
                <span class="text-xs sm:text-sm font-semibold text-stone-800 dark:text-stone-200">{challenge}</span>
                <input type="radio" name="biggestChallenge" value={challenge} class="w-4 h-4 text-amber-500 focus:ring-amber-500" />
              </label>
            ))}
          </div>
        </div>

        <div class="flex gap-3">
          <button
            type="button"
            id="btn-back-2"
            class="w-1/3 py-3.5 px-4 rounded-xl text-sm font-bold bg-stone-200 dark:bg-stone-800 hover:bg-stone-300 dark:hover:bg-stone-700 text-stone-800 dark:text-stone-200 transition-all"
          >
            Back
          </button>
          <button
            type="button"
            id="btn-next-2"
            class="w-2/3 py-3.5 px-4 rounded-xl text-sm font-bold bg-amber-500 hover:bg-amber-400 text-stone-950 shadow-md transition-all flex items-center justify-center gap-2"
          >
            <span>Continue</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </button>
        </div>
      </div>

      <!-- STEP 3: Agency Status & Timeline -->
      <div id="form-step-3" class="step-pane hidden space-y-5">
        <div>
          <h3 class="text-xl font-extrabold text-stone-900 dark:text-stone-100">Current Setup & Timeline</h3>
          <p class="text-xs sm:text-sm text-stone-500 dark:text-stone-400 mt-1">Let us know your current agency relationship and when you want to execute.</p>
        </div>

        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-stone-700 dark:text-stone-300 mb-2">
            Are you currently working with another marketing agency? *
          </label>
          <div class="space-y-2">
            {[
              "No",
              "Yes, but I'm unhappy with the results",
              "Yes, and I'm considering switching"
            ].map((agencyStatus) => (
              <label class="radio-card flex items-center justify-between p-3 rounded-xl border border-stone-200 dark:border-stone-700/80 bg-stone-50/50 dark:bg-stone-800/40 hover:bg-stone-100 dark:hover:bg-stone-800 cursor-pointer transition-all">
                <span class="text-xs sm:text-sm font-semibold text-stone-800 dark:text-stone-200">{agencyStatus}</span>
                <input type="radio" name="currentAgency" value={agencyStatus} class="w-4 h-4 text-amber-500 focus:ring-amber-500" />
              </label>
            ))}
          </div>
        </div>

        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-stone-700 dark:text-stone-300 mb-2">
            When are you looking to hire an agency? *
          </label>
          <div class="space-y-2">
            {[
              "I'm ready to start now",
              "Within the next 30 days",
              "Within 1–3 months",
              "I'm just researching",
              "Not sure yet"
            ].map((timeline) => (
              <label class="radio-card flex items-center justify-between p-3 rounded-xl border border-stone-200 dark:border-stone-700/80 bg-stone-50/50 dark:bg-stone-800/40 hover:bg-stone-100 dark:hover:bg-stone-800 cursor-pointer transition-all">
                <span class="text-xs sm:text-sm font-semibold text-stone-800 dark:text-stone-200">{timeline}</span>
                <input type="radio" name="hireTimeline" value={timeline} class="w-4 h-4 text-amber-500 focus:ring-amber-500" />
              </label>
            ))}
          </div>
        </div>

        <div class="flex gap-3">
          <button
            type="button"
            id="btn-back-3"
            class="w-1/3 py-3.5 px-4 rounded-xl text-sm font-bold bg-stone-200 dark:bg-stone-800 hover:bg-stone-300 dark:hover:bg-stone-700 text-stone-800 dark:text-stone-200 transition-all"
          >
            Back
          </button>
          <button
            type="button"
            id="btn-next-3"
            class="w-2/3 py-3.5 px-4 rounded-xl text-sm font-bold bg-amber-500 hover:bg-amber-400 text-stone-950 shadow-md transition-all flex items-center justify-center gap-2"
          >
            <span>Continue</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </button>
        </div>
      </div>

      <!-- STEP 4: 6-Month Goal & Contact Information -->
      <div id="form-step-4" class="step-pane hidden space-y-4">
        <div>
          <h3 class="text-xl font-extrabold text-stone-900 dark:text-stone-100">Goals & Contact Details</h3>
          <p class="text-xs sm:text-sm text-stone-500 dark:text-stone-400 mt-1">Please provide your active contact details so we can connect on WhatsApp.</p>
        </div>

        <div>
          <label for="input-6month-goal" class="block text-xs font-bold uppercase tracking-wider text-stone-700 dark:text-stone-300 mb-1">
            What is your goal for next 6 months? *
          </label>
          <textarea
            id="input-6month-goal"
            name="sixMonthGoal"
            rows="2"
            required
            placeholder="e.g. Scale revenue from 20 Lakh to 60 Lakh/month with a 4X ROAS"
            class="w-full px-3.5 py-2.5 rounded-xl border border-stone-300 dark:border-stone-700 bg-stone-50 dark:bg-stone-800 text-stone-900 dark:text-stone-100 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500"
          ></textarea>
        </div>

        <div>
          <label for="input-full-name" class="block text-xs font-bold uppercase tracking-wider text-stone-700 dark:text-stone-300 mb-1">
            Full Name *
          </label>
          <input
            type="text"
            id="input-full-name"
            name="fullName"
            required
            placeholder="Enter your full name"
            class="w-full px-3.5 py-2.5 rounded-xl border border-stone-300 dark:border-stone-700 bg-stone-50 dark:bg-stone-800 text-stone-900 dark:text-stone-100 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500"
          />
        </div>

        <div>
          <label for="input-email" class="block text-xs font-bold uppercase tracking-wider text-stone-700 dark:text-stone-300 mb-1">
            Email *
          </label>
          <input
            type="email"
            id="input-email"
            name="email"
            required
            placeholder="Enter your email address"
            class="w-full px-3.5 py-2.5 rounded-xl border border-stone-300 dark:border-stone-700 bg-stone-50 dark:bg-stone-800 text-stone-900 dark:text-stone-100 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500"
          />
        </div>

        <div>
          <label for="input-phone" class="block text-xs font-bold uppercase tracking-wider text-stone-700 dark:text-stone-300 mb-1">
            Phone / WhatsApp Number *
          </label>
          <input
            type="tel"
            id="input-phone"
            name="phoneNumber"
            required
            placeholder="e.g. 0347 7765284 or +92 347 7765284"
            class="w-full px-3.5 py-2.5 rounded-xl border border-stone-300 dark:border-stone-700 bg-stone-50 dark:bg-stone-800 text-stone-900 dark:text-stone-100 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500"
          />
        </div>

        <div class="flex gap-3 pt-2">
          <button
            type="button"
            id="btn-back-4"
            class="w-1/3 py-3.5 px-4 rounded-xl text-sm font-bold bg-stone-200 dark:bg-stone-800 hover:bg-stone-300 dark:hover:bg-stone-700 text-stone-800 dark:text-stone-200 transition-all"
          >
            Back
          </button>
          <button
            type="submit"
            id="btn-submit-whatsapp"
            class="w-2/3 py-3.5 px-4 rounded-xl text-sm font-bold bg-emerald-600 hover:bg-emerald-500 text-white shadow-lg shadow-emerald-600/20 hover:scale-[1.02] transition-all flex items-center justify-center gap-2"
          >
            <!-- WhatsApp Icon -->
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
            </svg>
            <span>Submit & Connect on WhatsApp</span>
          </button>
        </div>
      </div>

    </form>
  </div>
</div>

<script>
  const WHATSAPP_NUMBER = "923477765284"; // International format for 03477765284

  const backdrop = document.getElementById('booking-modal-backdrop');
  const closeBtn = document.getElementById('close-booking-modal');
  const openBtns = document.querySelectorAll('.open-booking-modal');

  const stepIndicator = document.getElementById('step-indicator');
  const progressBar = document.getElementById('progress-bar');

  const step1 = document.getElementById('form-step-1');
  const step2 = document.getElementById('form-step-2');
  const step3 = document.getElementById('form-step-3');
  const step4 = document.getElementById('form-step-4');

  let currentStep = 1;

  function updateStep(step) {
    currentStep = step;
    step1?.classList.toggle('hidden', currentStep !== 1);
    step2?.classList.toggle('hidden', currentStep !== 2);
    step3?.classList.toggle('hidden', currentStep !== 3);
    step4?.classList.toggle('hidden', currentStep !== 4);

    if (stepIndicator) stepIndicator.textContent = `Step ${currentStep} of 4`;
    if (progressBar) progressBar.style.width = `${(currentStep / 4) * 100}%`;
  }

  // Open Modal
  openBtns.forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      updateStep(1);
      backdrop?.classList.remove('hidden');
    });
  });

  // Close Modal
  closeBtn?.addEventListener('click', () => {
    backdrop?.classList.add('hidden');
  });

  backdrop?.addEventListener('click', (e) => {
    if (e.target === backdrop) {
      backdrop.classList.add('hidden');
    }
  });

  // Step Navigation Listeners
  document.getElementById('btn-next-1')?.addEventListener('click', () => {
    const website = (document.getElementById('input-website-url') as HTMLInputElement)?.value;
    const revSelected = document.querySelector('input[name="monthlyRevenue"]:checked');
    if (!website) {
      alert("Please enter your Website / Store URL to continue.");
      return;
    }
    if (!revSelected) {
      alert("Please select your average monthly ecommerce revenue.");
      return;
    }
    updateStep(2);
  });

  document.getElementById('btn-back-2')?.addEventListener('click', () => updateStep(1));

  document.getElementById('btn-next-2')?.addEventListener('click', () => {
    const spend = document.querySelector('input[name="adSpend"]:checked');
    const challenge = document.querySelector('input[name="biggestChallenge"]:checked');
    if (!spend) {
      alert("Please select your monthly ad spend.");
      return;
    }
    if (!challenge) {
      alert("Please select your biggest growth challenge.");
      return;
    }
    updateStep(3);
  });

  document.getElementById('btn-back-3')?.addEventListener('click', () => updateStep(2));

  document.getElementById('btn-next-3')?.addEventListener('click', () => {
    const agency = document.querySelector('input[name="currentAgency"]:checked');
    const timeline = document.querySelector('input[name="hireTimeline"]:checked');
    if (!agency) {
      alert("Please specify if you are currently working with another agency.");
      return;
    }
    if (!timeline) {
      alert("Please select when you are looking to hire an agency.");
      return;
    }
    updateStep(4);
  });

  document.getElementById('btn-back-4')?.addEventListener('click', () => updateStep(3));

  // Submit to WhatsApp
  document.getElementById('whatsapp-audit-form')?.addEventListener('submit', (e) => {
    e.preventDefault();

    const websiteUrl = (document.getElementById('input-website-url') as HTMLInputElement)?.value || "N/A";
    const monthlyRevenue = (document.querySelector('input[name="monthlyRevenue"]:checked') as HTMLInputElement)?.value || "Not selected";
    const adSpend = (document.querySelector('input[name="adSpend"]:checked') as HTMLInputElement)?.value || "Not selected";
    const biggestChallenge = (document.querySelector('input[name="biggestChallenge"]:checked') as HTMLInputElement)?.value || "Not selected";
    const currentAgency = (document.querySelector('input[name="currentAgency"]:checked') as HTMLInputElement)?.value || "Not selected";
    const hireTimeline = (document.querySelector('input[name="hireTimeline"]:checked') as HTMLInputElement)?.value || "Not selected";
    const sixMonthGoal = (document.getElementById('input-6month-goal') as HTMLTextAreaElement)?.value || "Not stated";
    const fullName = (document.getElementById('input-full-name') as HTMLInputElement)?.value || "N/A";
    const email = (document.getElementById('input-email') as HTMLInputElement)?.value || "N/A";
    const phoneNumber = (document.getElementById('input-phone') as HTMLInputElement)?.value || "N/A";

    const textMessage = `*Hi Hamza! I submitted a growth audit request on HBA website:*

🌐 *Website URL:* ${websiteUrl}
💰 *Monthly Revenue:* ${monthlyRevenue}
📈 *Monthly Ad Spend:* ${adSpend}
⚠️ *Biggest Challenge:* ${biggestChallenge}
🤝 *Working with Agency:* ${currentAgency}
⏳ *Hiring Timeline:* ${hireTimeline}
🎯 *6-Month Goal:* ${sixMonthGoal}

👤 *Contact Info:*
• *Name:* ${fullName}
• *Email:* ${email}
• *Phone:* ${phoneNumber}`;

    const encodedMsg = encodeURIComponent(textMessage);
    const whatsappUrl = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodedMsg}`;

    // Redirect to WhatsApp
    window.open(whatsappUrl, '_blank');
    backdrop?.classList.add('hidden');
  });
</script>
