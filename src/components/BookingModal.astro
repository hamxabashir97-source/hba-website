---
---

<div id="booking-modal-backdrop" class="fixed inset-0 z-50 hidden bg-stone-950/80 backdrop-blur-sm flex items-center justify-center p-4 overflow-y-auto">
  <div class="relative w-full max-w-lg bg-white dark:bg-stone-900 border border-stone-200 dark:border-stone-800 rounded-2xl shadow-2xl p-6 sm:p-8 my-8 text-stone-900 dark:text-stone-100">
    <!-- Close Button -->
    <button
      id="close-booking-modal"
      type="button"
      class="absolute top-4 right-4 p-2 text-stone-400 hover:text-stone-600 dark:hover:text-stone-200 transition-colors"
      aria-label="Close modal"
    >
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <!-- Header -->
    <div class="mb-6">
      <span class="px-2.5 py-1 rounded-md text-[11px] font-bold bg-amber-500/10 text-amber-700 dark:text-amber-400 border border-amber-500/20 uppercase tracking-wider">
        Free 30-Min Strategy Call
      </span>
      <h3 class="text-2xl font-extrabold mt-3">Book Your Growth Session</h3>
      <p class="text-xs sm:text-sm text-stone-600 dark:text-stone-400 mt-1">
        Select your store revenue and contact details to reserve your call slot with Hamza Bashir & the HBA team.
      </p>
    </div>

    <!-- Booking Form -->
    <form id="call-booking-form" class="space-y-4">
      <div>
        <label for="full-name" class="block text-xs font-bold uppercase tracking-wider text-stone-700 dark:text-stone-300 mb-1">
          Full Name *
        </label>
        <input
          type="text"
          id="full-name"
          name="fullName"
          required
          placeholder="e.g. Sarah Jenkins"
          class="w-full px-3.5 py-2.5 rounded-lg border border-stone-300 dark:border-stone-700 bg-stone-50 dark:bg-stone-800 text-stone-900 dark:text-stone-100 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500"
        />
      </div>

      <div>
        <label for="work-email" class="block text-xs font-bold uppercase tracking-wider text-stone-700 dark:text-stone-300 mb-1">
          Work / Store Email *
        </label>
        <input
          type="email"
          id="work-email"
          name="email"
          required
          placeholder="sarah@yourbrand.com"
          class="w-full px-3.5 py-2.5 rounded-lg border border-stone-300 dark:border-stone-700 bg-stone-50 dark:bg-stone-800 text-stone-900 dark:text-stone-100 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500"
        />
      </div>

      <div>
        <label for="store-url" class="block text-xs font-bold uppercase tracking-wider text-stone-700 dark:text-stone-300 mb-1">
          Website / Shopify Store URL *
        </label>
        <input
          type="url"
          id="store-url"
          name="storeUrl"
          required
          placeholder="https://yourbrand.com"
          class="w-full px-3.5 py-2.5 rounded-lg border border-stone-300 dark:border-stone-700 bg-stone-50 dark:bg-stone-800 text-stone-900 dark:text-stone-100 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500"
        />
      </div>

      <div>
        <label for="monthly-revenue" class="block text-xs font-bold uppercase tracking-wider text-stone-700 dark:text-stone-300 mb-1">
          Current Monthly Revenue *
        </label>
        <select
          id="monthly-revenue"
          name="monthlyRevenue"
          required
          class="w-full px-3.5 py-2.5 rounded-lg border border-stone-300 dark:border-stone-700 bg-stone-50 dark:bg-stone-800 text-stone-900 dark:text-stone-100 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500"
        >
          <option value="" disabled selected>Select Revenue Range</option>
          <option value="under-10k">Under $10k / ₹8L per month</option>
          <option value="10k-30k">$10k – $30k / ₹8L – ₹25L per month</option>
          <option value="30k-100k">$30k – $100k / ₹25L – ₹80L per month</option>
          <option value="100k-plus">$100k+ / ₹80L+ per month</option>
        </select>
      </div>

      <button
        type="submit"
        class="w-full mt-2 py-3.5 px-4 rounded-xl text-sm font-bold bg-amber-500 hover:bg-amber-400 text-stone-950 shadow-md hover:scale-[1.01] transition-all flex items-center justify-center gap-2"
      >
        <span>Confirm Booking Request</span>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </button>
    </form>

    <!-- Confirmation Toast -->
    <div id="booking-success-message" class="hidden mt-4 p-4 rounded-lg bg-emerald-500/10 border border-emerald-500/30 text-emerald-700 dark:text-emerald-400 text-xs sm:text-sm text-center font-medium">
      🎉 Request received! The HBA growth team will reach out to schedule your exact call slot within 2 hours.
    </div>
  </div>
</div>

<script>
  const backdrop = document.getElementById('booking-modal-backdrop');
  const closeBtn = document.getElementById('close-booking-modal');
  const form = document.getElementById('call-booking-form');
  const successMsg = document.getElementById('booking-success-message');
  const openBtns = document.querySelectorAll('.open-booking-modal');

  openBtns.forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      backdrop?.classList.remove('hidden');
    });
  });

  closeBtn?.addEventListener('click', () => {
    backdrop?.classList.add('hidden');
  });

  backdrop?.addEventListener('click', (e) => {
    if (e.target === backdrop) {
      backdrop.classList.add('hidden');
    }
  });

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (successMsg) {
      successMsg.classList.remove('hidden');
    }
    setTimeout(() => {
      form.reset();
      backdrop?.classList.add('hidden');
      if (successMsg) successMsg.classList.add('hidden');
    }, 3500);
  });
</script>
